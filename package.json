{
  "name": "write-or-die",
  "version": "1.0.0",
  "description": "Write More helps writers track daily writing and generate Chinese fiction exercises with DeepSeek.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "tsc -p tsconfig.test.json && node --test .tmp-tests/tests/*.test.js"
  },
  "keywords": [
    "obsidian",
    "writing",
    "deepseek"
  ],
  "author": "xuexue",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.0"
  }
}
